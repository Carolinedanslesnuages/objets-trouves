{
  "name": "api",
  "version": "0.0.1",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "start": "node --env-file-if-exists=.env src/main.ts",
    "start:dev": "node --env-file-if-exists=.env --watch src/main.ts",
    "lint": "oxlint --type-aware src/ test/ && eslint .",
    "test": "vitest run src",
    "test:e2e": "vitest run test",
    "build": "tsc --noEmit"
  },
  "dependencies": {
    "express": "5.3.0"
  },
  "devDependencies": {
    "@types/express": "5.0.6",
    "@types/node": "24.19.2",
    "@types/supertest": "7.2.1",
    "eslint": "10.15.0",
    "oxlint": "1.94.0",
    "oxlint-tsgolint": "7.0.2007",
    "supertest": "7.3.2",
    "typescript": "6.0.3",
    "typescript-eslint": "8.72.2",
    "vitest": "5.1.0"
  }
}
