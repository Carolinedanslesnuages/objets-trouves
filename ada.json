{
  "type": "service",
  "personnaliser": [
    "PROJET.md",
    "README.md",
    "AGENTS.md",
    "docs/adr/0001-choix-de-la-stack.md",
    "docs/adr/README.md",
    "front/index.html",
    "front/src/App.vue",
    "front/src/views/HomeView.vue",
    "front/src/views/__tests__/HomeView.spec.ts",
    "charts/app/Chart.yaml",
    "charts/app/values.yaml"
  ],
  "controlesRequis": [
    "Anti-fuite (gitleaks)",
    "API (lint, tests, compilation)",
    "Front (lint, types, tests dont accessibilité, compilation)",
    "Image et chart (construction, helm lint)",
    "Accessibilité RGAA (pages construites)",
    "Dépendances (paquet réel, version exacte, licence)",
    "Titre de PR (Conventional Commits, semver)",
    "Taille des fichiers (une responsabilité par fichier)"
  ],
  "controles": [
    "cd /app/api && npm run lint && npm test && npm run test:e2e && npm run build",
    "cd /app/front && npx oxlint . && npx eslint . && npm run type-check && npm run test:unit -- --run && npm run build-only"
  ],
  "apercu": {
    "image": "node:24-bookworm",
    "base": null,
    "npm": [
      "api",
      "front"
    ],
    "avant": [],
    "arrierePlan": [
      "cd /app/api && npm run start:dev"
    ],
    "principal": "cd /app/front && npx vite --host 0.0.0.0 --port 5173 --strictPort",
    "port": 5173
  },
  "deploiement": {
    "chart": "charts/app"
  }
}
